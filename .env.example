# Public URL the browser uses to reach the app (used for OIDC redirect building)
PUBLIC_BASE_URL=http://localhost:8080

# Postgres
POSTGRES_USER=roast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roast

# Express session cookie signing key — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars

# S NET / Authentik OIDC
# Issuer must serve /.well-known/openid-configuration
OIDC_ISSUER=https://sso.example.com/application/o/roast/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback
OIDC_SCOPES=openid profile email groups

# Name of the Authentik group/role that grants admin rights
ADMIN_ROLE=roast-admin

# Cloudflare URL Scanner
# Create a Custom API token with: Account > URL Scanner > Edit
CF_ACCOUNT_ID=
CF_API_TOKEN=

# GHCR image tag to run (overrides "latest"); pin to e.g. v1.2.3 or sha-abc1234
TAG=latest

# How aggressively to pull. "always" = check registry on every up.
# Set to "missing" if you build locally and don't want pulls clobbering it.
PULL_POLICY=always

# Ports exposed on host
API_PORT=3000
WEB_PORT=8080

# Where the SPA looks for the API (kept relative so nginx can proxy it)
VITE_API_BASE=/api
